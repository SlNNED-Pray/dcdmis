# When the app is reached through its own host name or LAN address
# (http://depeddipolog.test, http://192.168.1.28), the folder name is not part
# of the URL. Links that still contain the old /depeddipolog.test prefix are
# redirected to the same path at the root so old bookmarks keep working.
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^depeddipolog\.test(?:/(.*))?$ /$1 [R=301,L,NC]
</IfModule>
